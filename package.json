{
  "name": "@brandlen/agent-skills",
  "version": "1.0.0",
  "private": true,
  "description": "由 Brandon 维护、中文化和定制的 Agent Skills，支持通过 Vercel Skills CLI 安装。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brandon-Ln/skills.git"
  },
  "homepage": "https://github.com/Brandon-Ln/skills#readme",
  "bugs": {
    "url": "https://github.com/Brandon-Ln/skills/issues"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skills:list": "skills add Brandon-Ln/skills --list"
  },
  "keywords": [
    "agent-skills",
    "skills-cli",
    "vercel-skills",
    "codex",
    "cursor"
  ],
  "author": {
    "name": "Brandon Ln",
    "url": "https://github.com/Brandon-Ln"
  },
  "devDependencies": {
    "@brandlen/prettier-config": "^1.1.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "skills": "^1.5.23"
  },
  "prettier": "@brandlen/prettier-config",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "preserveUnused": true
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
